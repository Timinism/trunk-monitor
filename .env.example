# Seeded the first time Edge Watch creates its database.
# Later edits in Settings are kept in ./data, or in the Docker volume if you use Compose.

# demo or live. Leave SBC_HOST empty to start in demo mode.
SBC_HOST=
SBC_PORT=443
SBC_USERNAME=
SBC_PASSWORD=
# Appliances usually present a self-signed certificate.
SBC_TLS_VERIFY=false
POLL_INTERVAL_SECONDS=60
WATCH_FILTER=
ALERT_TO=
ALERT_ON_RECOVERY=true
ALERT_ON_DEGRADED=false
ALERT_ON_STARTUP=false
ALERT_REMINDER_MINUTES=0
UNREACHABLE_THRESHOLD=3
ALERT_TIMEZONE=America/Chicago
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Edge Watch <edge-watch@localhost>
# Local account. The UI and API stay closed until this is set, or Entra ID is.
# Username defaults to admin. Restart after changing the password.
MONITOR_USERNAME=admin
MONITOR_PASSWORD=
# Set true when browsers reach Edge Watch over HTTPS.
MONITOR_COOKIE_SECURE=false
# Optional. A random secret is stored in DATA_DIR when this is empty.
AUTH_SECRET=
# Microsoft Entra ID, single tenant. Leave blank to hide the Microsoft button.
# Register the redirect URI as a Web platform URI. It can be http on a private network.
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3847/api/session/oidc/callback
# Used when OIDC_REDIRECT_URI is empty.
APP_URL=
# Optional group object IDs or app role values. Empty allows anyone in the tenant.
OIDC_ALLOWED_GROUPS=
MONITORING_ENABLED=true
DATA_DIR=./data
