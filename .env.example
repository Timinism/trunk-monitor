# Seeded on the first launch when the data volume is empty.
# Later edits in the UI are kept in the volume.

# demo or live. Leave SBC_HOST empty to start in demo mode.
SBC_HOST=
SBC_PORT=443
SBC_USERNAME=
SBC_PASSWORD=
# Appliances usually present a self-signed certificate.
SBC_TLS_VERIFY=false
POLL_INTERVAL_SECONDS=60
WATCH_FILTER=
ALERT_TO=
ALERT_ON_RECOVERY=true
ALERT_ON_DEGRADED=false
ALERT_ON_STARTUP=false
ALERT_REMINDER_MINUTES=0
UNREACHABLE_THRESHOLD=3
ALERT_TIMEZONE=America/Chicago
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Edge Watch <edge-watch@localhost>
# Optional gate for the UI and API. Leave empty on a trusted network.
MONITOR_PASSWORD=
# Set true only when the app is served over HTTPS.
MONITOR_COOKIE_SECURE=false
MONITORING_ENABLED=true
DATA_DIR=./data
